# Paper/shadow is the default. Live trading requires BOTH flags below.
LIVE=0

# Required only for `live` and `cancel`. Never commit a real key.
HYPERLIQUID_PRIVATE_KEY=

# Optional. Defaults to the address derived from the private key.
# Used by `status` to print isolated positions when set (no key needed).
HYPERLIQUID_ACCOUNT=

# Case-sensitive HIP-3 names on EntropyIO only. Do not use xyz: or vntl:.
COINS=io:ANTH,io:SNDK

# Quote size in USDC notional per side. Live default stays small.
QUOTE_NOTIONAL_USD=50

# How many price ticks to sit behind the touch (ALO / post-only).
QUOTE_OFFSET_TICKS=2

# Isolated leverage cap. Always min(this, market max). Below ANTH's max of 3.
MAX_LEVERAGE=2

# Hyperliquid volume fee tier. Default 4 = 14d weighted volume > $500M (taker 0.028% / maker 0%).
FEE_TIER=4

# Entropy Partner program: https://docs.entropy.io/about-entropy/referrals.md
# Percentages apply only to Entropy's deployer share (50% when deployerFeeScale>=1).
# Card: 返佣 200% / 优惠 100% / TIER 4. 优惠 is invitee reward, not 100% off the full HL fee.
ENTROPY_TIER=4
ENTROPY_SELF_REBATE=2.0
ENTROPY_REFERRAL_REWARD=1.0
# Leave 0 so 优惠/referred-user benefit is NOT applied to this bot's own fills.
ENTROPY_REFERRED_USER_BENEFIT=0

# Optional Hyperliquid-side taker multiplier: gross_taker * (1 - REFERRAL_DISCOUNT).
# This is not Entropy 优惠. Leave 0 unless you have a measured HL referral discount.
REFERRAL_DISCOUNT=0

# Optional ALO maker-share rebate in basis points of notional (1 bp = 0.01%).
# Official tiers: 0.1 / 0.2 / 0.3 bp → -0.001% / -0.002% / -0.003%.
# Unset = assume maker fee 0 (tier 4 protocol maker is already 0).
MAKER_REBATE_BPS=

# Official Hyperliquid endpoints only.
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
